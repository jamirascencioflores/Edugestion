            <textField>
                <reportElement x="350" y="37" width="160" height="20" forecolor="#334155" uuid="88889999-0000-1111-2222-333344445555"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{FECHA_PAGO}]]></textFieldExpression>
            </textField>

            <!-- Línea Separadora Interna -->
            <line>
                <reportElement x="20" y="68" width="495" height="1" forecolor="#E2E8F0" uuid="99990000-1111-2222-3333-444455556666"/>
            </line>

            <!-- Fila 2: Concepto de Pago -->
            <staticText>
                <reportElement x="20" y="78" width="120" height="15" forecolor="#64748B" uuid="00001111-2222-3333-4444-555566667777"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[CONCEPTO]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="95" width="490" height="20" forecolor="#1E293B" uuid="11223344-5566-7788-9900-aabbccddeeff"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CONCEPTO}]]></textFieldExpression>
            </textField>

            <!-- Bloque Destacado de Monto Pagado -->
            <rectangle radius="8">
                <reportElement x="20" y="128" width="495" height="50" backcolor="#ECFDF5" uuid="22334455-6677-8899-00aa-bbccddeeff00"/>
                <graphicElement>
                    <pen lineWidth="1" lineStyle="Solid" lineColor="#A7F3D0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="35" y="143" width="150" height="20" forecolor="#047857" uuid="33445566-7788-9900-aabb-ccddeeff0011"/>
