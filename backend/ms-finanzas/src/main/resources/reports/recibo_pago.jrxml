                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[ESTADO: PAGADO]]></text>
            </staticText>

            <textField>
                <reportElement x="280" y="135" width="220" height="35" forecolor="#065F46" uuid="44556677-8899-00aa-bbcc-ddeeff001122"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["TOTAL: " + $P{MONTO_TOTAL}]]></textFieldExpression>
            </textField>

            <!-- Nota y Pie de Página -->
            <staticText>
                <reportElement x="0" y="210" width="535" height="15" forecolor="#94A3B8" uuid="55667788-9900-aabb-ccdd-eeff00112233"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Este documento sirve como comprobante oficial de pago digital generado por la plataforma EduGestión.]]></text>
