<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReciboPago" pageWidth="595" pageHeight="420" orientation="Landscape" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6e">

    <!-- Parámetros del Sistema -->
    <parameter name="NUMERO_RECIBO" class="java.lang.String"/>
    <parameter name="ESTUDIANTE_NOMBRE" class="java.lang.String"/>
    <parameter name="FECHA_PAGO" class="java.lang.String"/>
    <parameter name="CONCEPTO" class="java.lang.String"/>
    <parameter name="MONTO_TOTAL" class="java.lang.String"/>

    <title>
        <band height="70">
            <!-- Banner Superior Header sin bordes -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="535" height="55" backcolor="#6D28D9" uuid="f1e2d3c4-b5a6-9788-1122-334455667788"/>
            </rectangle>

            <staticText>
                <reportElement x="20" y="10" width="300" height="22" forecolor="#FFFFFF" uuid="11112222-3333-4444-5555-666677778888"/>
                <textElement verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[EduGestión • Comprobante de Pago]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="32" width="300" height="15" forecolor="#E9D5FF" uuid="a8b7c6d5-e4f3-2109-8877-665544332211"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Sistema Integrado de Gestión Educativa]]></text>
            </staticText>

            <!-- Badge Número de Recibo sin bordes -->
            <rectangle radius="6">
                <reportElement x="355" y="12" width="160" height="30" backcolor="#FFFFFF" uuid="22223333-4444-5555-6666-777788889999"/>
            </rectangle>

            <textField>
                <reportElement x="355" y="12" width="160" height="30" forecolor="#6D28D9" uuid="33334444-5555-6666-7777-888899990000"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["N° RECIBO: " + $P{NUMERO_RECIBO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="280">
            <!-- Tarjeta de Detalles Principal con Borde Válido (Solid) -->
            <rectangle radius="10">
                <reportElement x="0" y="5" width="535" height="185" backcolor="#F8FAFC" uuid="44445555-6666-7777-8888-999900001111"/>
                <graphicElement>
                    <pen lineWidth="1" lineStyle="Solid" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>

            <!-- Fila 1: Estudiante -->
