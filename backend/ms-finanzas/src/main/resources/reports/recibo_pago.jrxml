                <reportElement x="20" y="20" width="120" height="15" forecolor="#64748B" uuid="55556666-7777-8888-9999-000011112222"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ESTUDIANTE]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="37" width="310" height="20" forecolor="#0F172A" uuid="66667777-8888-9999-0000-111122223333"/>
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ESTUDIANTE_NOMBRE}]]></textFieldExpression>
            </textField>

            <!-- Fila 1 Derecha: Fecha -->
            <staticText>
                <reportElement x="350" y="20" width="160" height="15" forecolor="#64748B" uuid="77778888-9999-0000-1111-222233334444"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[FECHA DE PROCESO]]></text>
